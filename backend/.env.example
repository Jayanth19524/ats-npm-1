# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_olwECRWHsg26@ep-floral-leaf-amin1snc.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=your-super-random-32-byte-secret
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
# Set to true when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# ── Abuse Protection ──────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=20
SIGNUP_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=30
UPLOAD_CONCURRENCY_LIMIT=20
# Legacy/dev escape hatch only. Keep false in production.
SERVE_PUBLIC_UPLOADS=false
# Optional malware scanner hook, for example:
# RESUME_SCAN_COMMAND=clamscan
# RESUME_SCAN_ARGS=--no-summary
RESUME_SCAN_COMMAND=
RESUME_SCAN_ARGS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave all SMTP_* blank to run without email (emails are logged but not sent).
#
# Gmail (App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # 16-char App Password from Google Account
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxx
#
# Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxx
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulse ATS <no-reply@example.com>

# ── Resume Storage (S3) ───────────────────────────────────────────────────────
# Leave blank to store resumes locally in ./uploads/resumes/ (dev-only).
# In production set the S3 vars to upload to a private bucket. Downloads are
# served back through the authenticated API, not public bucket URLs.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# ── LocalStack / local S3-compatible testing ──────────────────────────────────
# Set S3_ENDPOINT to point at LocalStack instead of real AWS.
# See docker-compose.localstack.yml at the repo root.
# S3_ENDPOINT=http://localhost:4566
